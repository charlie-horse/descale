{
	"lexicon": 1,
	"id": "is.neuros.relay.allocate",
	"description": "Request an allocation to relay packets.",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"encoding": "application/json",
				"description": "The source and target address to relay between.",
				"schema": {
					"type": "object",
					"required": ["sourceAddress", "targetAddress"],
					"properties": {
						"sourceAddress": { "type": "ref", "ref": "is.neuros.types#address" },
						"targetAddress": { "type": "ref", "ref": "is.neuros.types#address" }
					}
				}
			},
			"output": {
				"encoding": "application/json",
				"description": "Returns an allocationId used to reference this relay.",
				"schema": {
					"type": "bytes",
					"minLength": 64,
					"maxLength": 64
				}
			}
		}
	}
}
